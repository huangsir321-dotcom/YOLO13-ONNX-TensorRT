source ~/.bashrc
nvcc --version


8.2安装cuddn
网址：https://developer.nvidia.com/cudnn
历史版本：https://developer.nvidia.cn/rdp/cudnn-archive
tar -xvf cudnn-linux-x86_64-8.9.0.131_cuda11-archive.tar.xz

sudo cp cuda/include/cudnn.h /usr/local/cuda-11.8/include
sudo cp cuda/lib64/libcudnn* /usr/local/cuda-11.8/lib64

sudo chmod a+r /usr/local/cuda-11.8/include/cudnn.h 
sudo chmod a+r /usr/local/cuda-11.8/lib64/libcudnn*

cd ~/cuddn所在目录下
sudo cp -r cudnn-linux-x86_64-8.9.0.131_cuda11-archive/include/* /usr/local/cuda-11.8/include/
sudo cp -r cudnn-linux-x86_64-8.9.0.131_cuda11-archive/lib/* /usr/local/cuda-11.8/lib64/


